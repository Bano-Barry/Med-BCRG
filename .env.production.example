# ==============================================================================
# CONFIGURATION DÉPLOIEMENT GLOBAL - INFIRMERIE MEDBCRG (ALMALINUX 10)
# ==============================================================================

# Ports des services exposés sur le serveur
FRONTEND_PORT=3003
BACKEND_PORT=5003

# Base de données PostgreSQL locale (Docker)
DB_NAME=infirmerie_bcrg
DB_USER=infirmerie_admin
DB_PASSWORD=choisir_un_mot_de_passe_robuste_db_2026
DB_PORT=5435

# Clés de chiffrement des Tokens JWT (générer avec: openssl rand -hex 64)
JWT_ACCESS_SECRET=changer_par_une_cle_secrete_jwt_access_64_chars_min
JWT_REFRESH_SECRET=changer_par_une_cle_secrete_jwt_refresh_64_chars_min
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS : Origines autorisées (ex: http://srv-homologation:3003,http://localhost:3003 ou *)
CORS_ORIGIN=*

# URL de l'API injectée au build du frontend
# Laisser vide pour utiliser le reverse proxy Nginx automatique (recommandé)
# ou définir l'URL absolue ex: http://srv-homologation:5003
VITE_API_URL=

# Automatisation au premier démarrage
AUTO_MIGRATE=true
AUTO_SEED=true

# Configuration SSO BCRG HUB
BCRG_HUB_URL=http://localhost:5001
BCRG_HUB_JWKS_URL=http://localhost:5001/api/security/.well-known/jwks.json
BCRG_HUB_JWT_SECRET=supersecret_bcrg_hub_production_jwt_key_2026
VITE_BCRG_HUB_URL=http://localhost:5001
