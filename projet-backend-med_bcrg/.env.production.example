# ==============================================================================
# CONFIGURATION PRODUCTION - SERVEUR ON-PREMISE (AlmaLinux 10)
# ==============================================================================

# Port d'écoute exposé sur l'hôte
PORT=5003

# Base de données PostgreSQL locale (Docker)
DB_NAME=infirmerie_bcrg
DB_USER=infirmerie_admin
DB_PASSWORD=choisir_un_mot_de_passe_robuste_db_2026
DB_PORT=5432

# Clés de chiffrement des Tokens JWT (générer avec: openssl rand -hex 64)
JWT_ACCESS_SECRET=changer_par_une_cle_secrete_jwt_access_64_chars_min
JWT_REFRESH_SECRET=changer_par_une_cle_secrete_jwt_refresh_64_chars_min
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS : Origines autorisées (adresses IP ou noms d'hôte du frontend séparés par des virgules)
# Ex: http://srv-homologation:5173,http://192.168.1.50:5173
CORS_ORIGIN=*

# Automatisation au premier démarrage
AUTO_MIGRATE=true
AUTO_SEED=true

# Configuration SSO BCRG HUB (si applicable)
BCRG_HUB_URL=http://localhost:5001
BCRG_HUB_JWKS_URL=http://localhost:5001/api/security/.well-known/jwks.json
BCRG_HUB_JWT_SECRET=supersecret_sso_portal_key_2026
