# ==============================================================================
# Environnement & Port
# ==============================================================================
NODE_ENV=development
PORT=5000

# ==============================================================================
# Base de données PostgreSQL
# ==============================================================================
# Local: postgresql://postgres:postgres@localhost:5432/infirmerie_bcrg?schema=public
# Docker: postgresql://postgres:postgres_secure_password_2026@postgres:5432/infirmerie_bcrg?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infirmerie_bcrg?schema=public

# ==============================================================================
# Sécurité & Authentification JWT
# Générer des clés aléatoires : openssl rand -hex 64
# ==============================================================================
JWT_ACCESS_SECRET=changer_par_une_cle_secrete_d_au_moins_32_caracteres_aleatoires
JWT_REFRESH_SECRET=changer_par_une_autre_cle_secrete_d_au_moins_32_caracteres_aleatoires
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# CORS (Origines frontend autorisées séparées par des virgules)
# Ex: http://localhost:5173,http://srv-homologation:5173,http://192.168.1.50:5173
# ==============================================================================
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Stockage des fichiers uploadés
# ==============================================================================
UPLOAD_DIR=./uploads

# ==============================================================================
# Intégration SSO BCRG HUB
# ==============================================================================
BCRG_HUB_URL=http://localhost:5001
BCRG_HUB_JWKS_URL=http://localhost:5001/api/security/.well-known/jwks.json
BCRG_HUB_JWT_SECRET=supersecret_sso_portal_key_2026
# BCRG_HUB_PUBLIC_KEY_PATH=
# BCRG_HUB_PUBLIC_KEY=
